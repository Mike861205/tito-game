# Tito Game - plantilla para Liquid Web (sin secretos)
NODE_ENV=production
API_PORT=3001
API_HOST=127.0.0.1
CORS_ORIGINS=https://tito.tudominio.com

# Aplicacion: endpoint pooled de la branch production (incluye -pooler)
DATABASE_URL=postgresql://usuario:password@ep-produccion-pooler.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# Migraciones: endpoint directo de la misma branch (NO incluye -pooler)
DIRECT_URL=postgresql://usuario:password@ep-produccion.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require

JWT_SECRET=reemplazar_con_un_secreto_aleatorio_de_48_bytes
JWT_EXPIRES_IN=7d
SCORE_HMAC_SECRET=reemplazar_con_otro_secreto_aleatorio_de_48_bytes

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_ENABLED=false

STATIC_DIR=../game/dist
VITE_API_URL=
VITE_SCORE_HMAC_SECRET=debe_coincidir_con_SCORE_HMAC_SECRET
VITE_GAME_VERSION=1.0.0
