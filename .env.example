# ============================================================
# TITO GAME - Variables de entorno (copiar a .env)
# ============================================================
# NUNCA subas el archivo .env real al repositorio.

NODE_ENV=development

# ---------- API ----------
API_PORT=3001
API_HOST=0.0.0.0
# Origenes permitidos por CORS, separados por coma
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- Seguridad ----------
# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=7d
# Firma de puntajes para evitar scores falsos desde el cliente
SCORE_HMAC_SECRET=otro-secreto-largo-y-aleatorio

# ---------- Neon Postgres ----------
# DESARROLLO -> usa una branch de Neon llamada "development"
# Formato: postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/tito_game?sslmode=require
DATABASE_URL=postgresql://user:password@ep-dev-pooler.us-east-2.aws.neon.tech/tito_game?sslmode=require
# Conexion directa (sin pooler) que Prisma Migrate necesita
DIRECT_URL=postgresql://user:password@ep-dev.us-east-2.aws.neon.tech/tito_game?sslmode=require

# PRODUCCION (se define en el servidor Liquid Web, no aqui)
# DATABASE_URL=postgresql://user:password@ep-prod-pooler.us-east-2.aws.neon.tech/tito_game?sslmode=require
# DIRECT_URL=postgresql://user:password@ep-prod.us-east-2.aws.neon.tech/tito_game?sslmode=require

# ---------- OpenAI ----------
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o-mini
# Desactiva llamadas reales a OpenAI y usa respuestas locales (util sin key)
AI_ENABLED=false

# ---------- Cliente (Vite) ----------
VITE_API_URL=http://localhost:3001
VITE_GAME_VERSION=0.1.0
# Debe ser IGUAL a SCORE_HMAC_SECRET (el cliente firma, el servidor verifica).
# Nota: al ir en el bundle es publico; sirve para frenar bots, no jugadores expertos.
# La validacion real (tope de puntaje, tiempo, run unico) se hace en el servidor.
VITE_SCORE_HMAC_SECRET=otro-secreto-largo-y-aleatorio
# Pon true para ver las cajas de colision
VITE_PHYSICS_DEBUG=false

# ---------- Superadmin local (NUNCA habilitar en produccion) ----------
# Las credenciales reales van en .env.superadmin, archivo ignorado por Git.
SUPERADMIN_ENABLED=false
SUPERADMIN_USER=
SUPERADMIN_PASSWORD=
